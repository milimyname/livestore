{
	"name": "packsil",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"cap:sync": "pnpm build && pnpm exec cap sync",
		"cap:ios": "pnpm cap:sync && pnpm exec cap open ios",
		"cap:android": "pnpm cap:sync && pnpm exec cap open android",
		"cap:build:ios": "pnpm build && pnpm exec cap sync ios && pnpm exec cap build ios",
		"cap:build:android": "pnpm build && pnpm exec cap sync android && pnpm exec cap build android",
		"supabase-ts": "pnpm dlx supabase gen types typescript --project-id mubgtvvkhcxmmqblssrb > src/lib/types/database.types.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.33.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.27.3",
		"@sveltejs/vite-plugin-svelte": "^6.1.1",
		"@tailwindcss/vite": "^4.1.11",
		"@vitejs/plugin-basic-ssl": "^2.1.0",
		"@vitest/browser": "^3.2.4",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.3.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.54.2",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.1",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0",
		"vite": "^7.1.1",
		"vite-plugin-devtools-json": "^0.2.1",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^0.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@capacitor/android": "^7.4.2",
		"@capacitor/cli": "^7.4.2",
		"@capacitor/core": "^7.4.2",
		"@capacitor/geolocation": "^7.1.4",
		"@capacitor/ios": "^7.4.2",
		"@effect/platform": "^0.87.13",
		"@livestore/adapter-web": "^0.3.1",
		"@livestore/common": "^0.3.1",
		"@livestore/devtools-vite": "^0.3.1",
		"@livestore/livestore": "^0.3.1",
		"@livestore/peer-deps": "^0.3.1",
		"@livestore/sync-cf": "^0.3.1",
		"@livestore/sync-electric": "^0.3.1",
		"@livestore/wa-sqlite": "1.0.5-dev.2",
		"@supabase/supabase-js": "^2.54.0",
		"effect": "^3.17.7",
		"postgres": "^3.4.7"
	}
}